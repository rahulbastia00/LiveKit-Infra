          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active Pods Count",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
